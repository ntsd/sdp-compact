    {
      "id": "claim_43a0035a4b4b41a987dec9718b60969e",
      "statement": "uint8ArrayToBase92 performs big-endian base-256 to base-92 conversion, preserves leading zero bytes by repeating the LEADER character, and throws 'Non-zero carry' if the division leaves an inconsistent carry.",
