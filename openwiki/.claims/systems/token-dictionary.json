    },
    {
      "id": "claim_af1ccc17253d40338a4981160fb7a042",
      "statement": "mediaEncode/mediaDecode substitute only the media-type token (index 0) and protocol token (index 2) of the m= line (audio to A, video to V, application to P, UDP/TLS/RTP/SAVPF to T, UDP/DTLS/SCTP to U); everything after the protocol (payload types/formats) is never touched, so codec names and data-channel formats survive intact.",
      "evidence": [
        {
          "resource": "repo://src/dict.ts#L175-L227",
          "version": "repo-lines-v1:sha256:447c663c8fa62e91073a7cca9d89e5e2cd53a72ee8c34e646a9d3fe645a65e21:"
        }
      ]
    },
    {
      "id": "claim_84765531d43746d79edc6372bb790636",
      "statement": "candidateEncode/candidateDecode substitute only exact tokens at fixed positions of the a=candidate line (protocol udp to U, ip 0.0.0.0 to Z, raddr-0.0.0.0 to A-Z, typ-srflx to S, the full typ-host-generation-0-network-cost-999 sequence to H, the full rport-0-generation-0-network-cost-999 sequence to R); because matching is position- and whole-token-based, the single-character codes never match inside a longer token, so hostnames or attribute values that contain a code letter survive the round-trip untouched.",
