    {
      "id": "claim_a38dbdae55e8437e9a2b4fae8a472ad2",
      "statement": "FieldReplaceMap shrinks two-character field prefixes to one character (v= to V, o= to O, s= to S, c= to C, a= to A, m= to M, t= to T) and AttributeReplaceMap shrinks a= attribute names to one letter (rtcp to R, ice-ufrag to U, ice-pwd to P, ice-options to O, fingerprint to F, candidate to C, sctp-port to S, max-message-size to M, extmap to E, rtpmap to T, rtcp-fb to B, fmtp to Z); these are exact-key lookups consulted by the replaceFieldNames pass.",
      "evidence": [
        {
          "resource": "repo://src/dict.ts#L17-L25",
          "version": "repo-lines-v1:sha256:67c84988f0ef7c8f9026011a633131d7c402eeb4b697df1fd4f24f09fb76c559:"
