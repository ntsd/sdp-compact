        }
      ]
    },
    {
      "id": "claim_56ff2a3f15a34482bd1f760975a9b4e0",
      "statement": "compact (the RTCSessionDescriptionInit-level function) prepends a single-character RTCSdpType prefix (O=offer, A=answer, P=pranswer, R=rollback) to the compacted SDP string; decompact strips and decodes that prefix back to the type.",
      "evidence": [
        {
          "resource": "repo://src/compact.ts#L20-L48",
          "version": "repo-lines-v1:sha256:8034b50f21ebd479d16acd6f9561dfe90b24b6f5a7d477924660ee3dddceb803:"
