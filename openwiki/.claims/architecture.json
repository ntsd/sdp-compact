    {
      "id": "claim_f910040cdee0450ca7fcc098baf69544",
      "statement": "compact/compactSDP run the SDP through three ordered stages: a line-level transform (compactSDPStr) that drops fixed fields and rewrites media/candidate/fingerprint/connection/extmap/rtcp-fb lines joined with '~', an optional field-name substitution pass, and an optional zlib-deflate (level 9) plus base64/base92 encoding pass.",
      "evidence": [
        {
          "resource": "repo://src/compact.ts#L58-L93",
          "version": "repo-lines-v1:sha256:d9a606fc25068495c1cb4cf803977cdc175e10eb66a4e1a5e82cba98c550b71e:"
