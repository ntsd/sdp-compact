    },
    {
      "id": "claim_2bf4385f7d1c440fbab2173c2425a9eb",
      "statement": "Compaction is asymmetric between offer and answer: compact drops a=setup:, a=mid:, and a=group:BUNDLE, and decompact reconstructs them using the isOffer flag, writing a=setup:actpass for offer and a=setup:active for answer and reassigning sequential a=mid: values plus a re-derived a=group:BUNDLE line.",
      "evidence": [
        {
          "resource": "repo://src/decompact.ts#L214-L237",
          "version": "repo-lines-v1:sha256:bd79a532d95cc5a4c4cd82ce2f7654d2df52c11dd8d617ee4f457f7468b03e57:"
